# Copy this file to `backend/.env` and fill in real values.
# `backend/.env` is gitignored and must never be committed.

# --- Required ---

# OpenAI API key (used by ChatOpenAI).
OPENAI_API_KEY=

# --- Optional ---

# Tavily API key for web search (if wired up via MCP or langchain-tavily).
TAVILY_API_KEY=

# LangSmith tracing (leave blank / unset to disable).
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-starter
